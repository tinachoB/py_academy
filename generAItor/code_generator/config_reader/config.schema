{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "comment": {
      "type": "string"
    },
    "paths": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "string",
          "minLength": 1
        },
        "prompts": {
          "type": "string",
          "minLength": 1
        },
        "schemas": {
          "type": "string",
          "minLength": 1
        },
        "output": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["sources", "prompts", "schemas", "output"],
      "additionalProperties": false
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "comment": {
            "type": "string"
          },
          "generate": {
            "type": "boolean"
          },
          "output": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "tags": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "tag": {
                      "type": "string",
                      "minLength": 1
                    },
                    "file": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["tag"],
                  "oneOf": [
                    {"required": ["file"]},
                    {"required": ["value"]}
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": ["file", "tags"],
            "additionalProperties": false
          }
        },
        "required": ["generate", "output", "prompt"],
        "additionalProperties": false
      }
    }
  },
  "required": ["paths", "targets"],
  "additionalProperties": false
}
