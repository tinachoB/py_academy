Based on the next html file

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Person</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://unpkg.com/vue@2.6.14/dist/vue.js"></script>
</head>
<body>
  <div id="app" class="container mt-5">
    <h1 class="mb-4">Person</h1>

    <form @submit.prevent="submitForm" novalidate>
      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <label for="Id" class="form-label">ID</label>
            <input type="number" class="form-control" id="Id" v-model="person.Id" required>
          </div>
          <div class="mb-3">
            <label for="FirstName" class="form-label">First Name</label>
            <input type="text" class="form-control" id="FirstName" v-model="person.FirstName" :class="{ 'is-invalid': firstNameInvalid }" maxlength="35" required>
            <div class="invalid-feedback" v-if="firstNameInvalid">First name is required and must be 35 characters or less.</div>
          </div>
          <div class="mb-3">
            <label for="YearsOld" class="form-label">Years Old</label>
            <input type="number" class="form-control" id="YearsOld" v-model="person.YearsOld" :class="{ 'is-invalid': yearsOldInvalid }" min="0" required>
            <div class="invalid-feedback" v-if="yearsOldInvalid">Years old is required and must be 0 or greater.</div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <label for="LastName" class="form-label">Last Name</label>
            <input type="text" class="form-control" id="LastName" v-model="person.LastName" :class="{ 'is-invalid': lastNameInvalid }" maxlength="35" required>
            <div class="invalid-feedback" v-if="lastNameInvalid">Last name is required and must be 35 characters or less.</div>
          </div>
          <div class="mb-3">
            <label for="E-Mail" class="form-label">E-Mail</label>
            <input type="email" class="form-control" id="E-Mail" v-model="person.Email" :class="{ 'is-invalid': emailInvalid }" required>
            <div class="invalid-feedback" v-if="emailInvalid">E-Mail is required and must be valid.</div>
          </div>
        </div>
      </div>
      <div class="d-flex justify-content-end">
        <button type="submit" class="btn btn-primary me-2" id="submitBtn">Save</button>
        <button type="button" class="btn btn-danger me-2" id="deleteBtn">Delete</button>
        <button type="button" class="btn btn-secondary" id="cancelBtn">Cancel</button>
      </div>
    </form>
  </div>

  <script>
    new Vue({
      el: '#app',
      data: {
        person: {
          Id: '',
          FirstName: '',
          LastName: '',
          YearsOld: '',
          Email: ''
        }
      },
      computed: {
        firstNameInvalid() {
          return this.person.FirstName.trim() === '' || this.person.FirstName.length > 35
        },
        lastNameInvalid() {
          return this.person.LastName.trim() === '' || this.person.LastName.length > 35;
        },
        yearsOldInvalid() {
          return this.person.YearsOld === '' || this.person.YearsOld < 0;
        },
        emailInvalid() {
          const emailRegex = /^[\w-]+(\.[\w-]+)*@([\w-]+\.)+[a-zA-Z]{2,7}$/;
          return this.person.Email.trim() === '' || !emailRegex.test(this.person.Email);
        }
      },
      methods: {
        submitForm() {
          if (!this.firstNameInvalid && !this.lastNameInvalid && !this.yearsOldInvalid && !this.emailInvalid) {
            alert('Form submitted successfully!');
          } else {
            alert('Please fix the errors in the form before submitting.');
          }
        }
      }
    });
  </script>
  <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.6/dist/umd/popper.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.min.js"></script>
</body>
</html>

