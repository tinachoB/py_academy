{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "className": "Item",
  "properties": {
    "id": {
      "type": "integer",
      "default": -1
    },
    "sku": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "price": {
      "type": "number",
      "default": 0.0
    },
    "discount": {
      "type": "number",
      "default": 0.0
    }
  },
  "required": ["id", "sku", "description", "price"]
}