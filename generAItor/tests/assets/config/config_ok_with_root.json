{
  "comment": "This is well formed config file.",
  "paths": {
    "root": "home/code-generation",
    "sources": "{root}/frontend",
    "prompts": "{root}/prompts",
    "schemas": "{root}/schemas",
    "output": "{root}/output"
  },
  "targets": [
    {
      "comment": "Customer SCSS generation",
      "output": "{output}/customer.scss",
      "generate": true,
      "prompt": {
        "file": "{prompts}/angular.components.prompt",
        "tags": [
          { "tag": "template_class", "file": "{sources}/components/employee.scss"},
          { "tag":"template_schema", "file": "{schemas}/employee.json"},
          { "tag":"target_schema",   "file": "{schemas}/customers.json"},
          { "tag":"type", "value": "scss"}
        ]
      }
    },
    {
      "output": "{output}/customer.html",
      "generate": false,
      "prompt": {
        "file": "{prompts}/angular.components.prompt",
        "tags": [
          { "tag": "template_class", "file": "{sources}/components/employee.html"},
          { "tag":"template_schema", "file": "{schemas}/employee.json"},
          { "tag":"target_schema",   "file": "{schemas}/customers.json"},
          { "tag":"type", "value": "html"}
        ]
      }
    }
  ]
}