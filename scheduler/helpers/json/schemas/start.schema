{
    "$schema": "http://json-schema.org/draft-07/schema",
    "$id": "http://example.com/example.json",
    "type": "object",
    "title": "The root schema",
    "description": "The root schema comprises the entire JSON document.",
    "default": {},
    "examples": [
        {
            "time": "11:30",
            "verb": "start",
            "program_name": "program",
            "pidfile_name": "test.pid"
        }
    ],
    "required": [
        "time",
        "verb",
        "program_name",
        "pidfile_name"
    ],
    "properties": {
        "time": {
            "$id": "#/properties/time",
            "type": "string",
            "minLength": 5,
            "maxLength": 5,
            "title": "The time schema",
            "description": "An explanation about the purpose of this instance.",
            "default": "",
            "examples": [
                "11:30"
            ]
        },
        "verb": {
            "$id": "#/properties/verb",
            "type": "string",
            "title": "The verb schema",
            "description": "An explanation about the purpose of this instance.",
            "default": "",
            "examples": [
                "start"
            ]
        },
        "program_name": {
            "$id": "#/properties/program_name",
            "type": "string",
            "title": "The program_name schema",
            "description": "An explanation about the purpose of this instance.",
            "default": "",
            "examples": [
                "program"
            ]
        },
        "pidfile_name": {
            "$id": "#/properties/pidfile_name",
            "type": "string",
            "title": "The pidfile_name schema",
            "description": "An explanation about the purpose of this instance.",
            "default": "",
            "examples": [
                "test.pid"
            ]
        }
    },
    "additionalProperties": true
}