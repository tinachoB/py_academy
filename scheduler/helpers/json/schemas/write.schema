{
    "$schema": "http://json-schema.org/draft-07/schema",
    "$id": "http://example.com/example.json",
    "type": "object",
    "title": "The root schema",
    "description": "The root schema comprises the entire JSON document.",
    "default": {},
    "examples": [
        {
            "time": "13:30",
            "verb": "modify",
            "socket_name": "/var/run/any_sock.sock",
            "message": "37"
        }
    ],
    "required": [
        "time",
        "verb",
        "socket_name",
        "message"
    ],
    "properties": {
        "time": {
            "$id": "#/properties/time",
            "type": "string",
            "minLength": 5,
            "maxLength": 5,
            "title": "The time schema",
            "description": "An explanation about the purpose of this instance.",
            "default": "",
            "examples": [
                "13:30"
            ]
        },
        "verb": {
            "$id": "#/properties/verb",
            "type": "string",
            "title": "The verb schema",
            "description": "An explanation about the purpose of this instance.",
            "default": "",
            "examples": [
                "modify"
            ]
        },
        "socket_name": {
            "$id": "#/properties/socket_name",
            "type": "string",
            "title": "The socket_name schema",
            "description": "An explanation about the purpose of this instance.",
            "default": "",
            "examples": [
                "/var/run/any_sock.sock"
            ]
        },
        "message": {
            "$id": "#/properties/message",
            "type": "string",
            "title": "The message schema",
            "description": "An explanation about the purpose of this instance.",
            "default": "",
            "examples": [
                "37"
            ]
        }
    },
    "additionalProperties": true
}